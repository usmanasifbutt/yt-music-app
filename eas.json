{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": { "buildType": "apk" }
    },
    "beta": {
      "extends": "preview",
      "env": { "APP_VARIANT": "beta" }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "apk" }
    }
  }
}
